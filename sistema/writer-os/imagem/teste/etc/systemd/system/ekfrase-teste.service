# SÓ na imagem de teste: o relato na serial (tests/writer-os/qemu.py lê de lá). Confere, como root,
# o que o writer não pode conferir (§8: a partição, nada de sudo, os grupos, o Secure Boot) e
# repassa o que o agente de teste da casca escreve em /run/ekfrase/teste/relato.
[Unit]
Description=Ekfrase Writer OS: o relato do teste na serial
After=ekfrase-dados.service
Before=ekfrase-sessao.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /run/ekfrase/teste && touch /run/ekfrase/teste/relato && chown -R 1000:1000 /run/ekfrase/teste'
# o teste da placa de vídeo (qemu.py --gpu passa -fw_cfg name=opt/ekfrase/gpu): a sessão NÃO força o pixman
ExecStartPre=/bin/sh -c 'modprobe qemu_fw_cfg 2>/dev/null; if [ -e /sys/firmware/qemu_fw_cfg/by_name/opt/ekfrase/gpu ]; then touch /run/ekfrase/teste/gpu; fi'
ExecStart=/usr/lib/ekfrase/teste/relato.sh

[Install]
WantedBy=multi-user.target
